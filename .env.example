# Supabase (Settings > API). La clave publicable puede ir al navegador; la secret key NUNCA.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mapa del atlas: usa OpenStreetMap sin clave. Opcional: otro servidor de teselas (p. ej. MapTiler o Stadia)
# si el tráfico crece; la política de OSM pide un uso moderado de sus servidores.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
