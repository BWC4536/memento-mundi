# Supabase (Settings > API). La clave publicable puede ir al navegador; la secret key NUNCA.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Maps (página Explorar). Clave de Google Cloud con "Maps JavaScript API",
# restringida por referente HTTP a tus dominios. Map ID opcional (recomendado en producción).
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
